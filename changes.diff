       13: // GetCSRF returns the CSRF token from the given URL using the provided session.
       14: func GetCSRF(t testing.TB, session *TestSession, urlStr string) string {
       15: 	t.Helper()
       16: 	req := NewRequest(t, "GET", urlStr)
       17: 	resp := session.MakeRequest(t, req, http.StatusOK)
       18: 	htmlDoc := NewHTMLParser(t, resp.Body)
       19: 
       20: 	// Try to find in meta tag
       21: 	csrf, exists := htmlDoc.doc.Find("meta[name='_csrf']").Attr("content")
       22: 	if exists {
       23: 		return csrf
       24: 	}
       25: 
       26: 	// Try to find in input field
       27: 	csrf, exists = htmlDoc.doc.Find("input[name='_csrf']").Attr("value")
       28: 	if exists {
       29: 		return csrf
       30: 	}
       31: 
       32: 	assert.Fail(t, "CSRF token not found in "+urlStr)
       33: 	return ""
       34: }
