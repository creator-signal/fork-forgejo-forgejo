       84: // LookupRootIssue resolves the root issue of this issue, which has no parent issue
       85: func (issue *Issue) LookupRootIssue(ctx context.Context) (root *Issue, depth int, err error) {
       86: 	root = issue
       87: 	depth = 0
       88: 	for {
       89: 		if root.ParentIssueID == nil {
       90: 			return root, depth, nil
       91: 		}
       92: 		if err = root.LoadParentIssue(ctx); err != nil {
       93: 			return nil, 0, err
       94: 		}
       95: 		root = root.ParentIssue
       96: 		depth++
       97: 	}
       98: }
