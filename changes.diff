      100: // UpdateParentIssue adds issue to another issue as a sub-issue.
      101: // Setting parent issue to nil means removing parent issue
      102: func (issue *Issue) UpdateParentIssue(ctx context.Context, parent *Issue, doer *user_model.User) (err error) {
      103: 	if issue.ParentIssueID != nil && parent != nil && *issue.ParentIssueID == parent.ID {
      104: 		return nil
      105: 	}
      106: 	if issue.ParentIssueID == nil && parent == nil {
      107: 		return nil
      108: 	}
      109: 	if err = issue.LoadParentIssue(ctx); err != nil {
      110: 		return err
      111: 	}
      112: 	oldParent := issue.ParentIssue
      113: 
      114: 	if parent != nil {
      115: 		if _, _, err := parent.LookupRootIssue(ctx); err != nil {
      116: 			return err
      117: 		}
      118: 
      119: 		// Validate no circular parent issues
      120: 		curParent := parent
      121: 		// after parent.LookupRootIssue, all parent issues on the path to root has been loaded
      122: 		for curParent != nil {
      123: 			if curParent.ID == issue.ID {
      124: 				return ErrCircularParentIssue{issue.ID, parent.ID}
      125: 			}
      126: 			curParent = curParent.ParentIssue
      127: 		}
      128: 	}
      129: 
      130: 	ctx, committer, err := db.TxContext(ctx)
      131: 	if err != nil {
      132: 		return err
      133: 	}
      134: 	defer committer.Close()
      135: 
      136: 	var parentID *int64
      137: 	if parent != nil {
      138: 		parentID = &parent.ID
      139: 	}
      140: 
      141: 	// Update parent ID
      142: 	if err = UpdateIssueCols(ctx, &Issue{ID: issue.ID, ParentIssueID: parentID}, "parent_id"); err != nil {
      143: 		return err
      144: 	}
      145: 
      146: 	issue.ParentIssueID = parentID
      147: 	// invalidates caches
      148: 	issue.isParentIssueLoaded = false
      149: 	if parent != nil {
      150: 		parent.isSubIssuesLoaded = false
      151: 	}
      152: 
      153: 	// Make the comment
      154: 	if oldParent != nil {
      155: 		// removed old parent
      156: 		if err = createSubIssueComment(ctx, doer, oldParent, issue, false); err != nil {
      157: 			return fmt.Errorf("createSubIssueComment, unlink old: %w", err)
      158: 		}
      159: 	}
      160: 	if parent != nil {
      161: 		// added new parent
      162: 		if err = createSubIssueComment(ctx, doer, parent, issue, true); err != nil {
      163: 			return fmt.Errorf("createSubIssueComment, link new: %w", err)
      164: 		}
      165: 	}
      166: 
      167: 	return committer.Commit()
      168: }
