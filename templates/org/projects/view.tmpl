{{template "base/head" .}}
<div class="page-content organization repository projects view-project">
	{{if .ContextUser.IsOrganization}}
		{{template "org/header" .}}
	{{else}}
		{{template "shared/user/org_profile_avatar" .}}
		<div class="ui container tw-mb-4">
			{{template "user/overview/header" .}}
		</div>
	{{end}}
	<main id="main" aria-label="{{.Title}}" class="ui container fluid padded">
		{{template "projects/view" .}}
	</main>
</div>
{{template "base/footer" .}}
