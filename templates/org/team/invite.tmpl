{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content organization invite">
	<div class="ui middle very relaxed page grid">
		<div class="column">
			<form class="ui form" action="" method="post">
				<div class="ui attached segment">
					{{template "base/alert" .}}
					<div class="invite-content">
						<hgroup>
							<div>{{ctx.AvatarUtils.Avatar .Organization 140}}</div>
							<h2>{{ctx.Locale.Tr "org.teams.invite.title" .Team.Name .Organization.Name}}</h2>
						</hgroup>

						<p>{{ctx.Locale.Tr "org.teams.invite.by" .Inviter.Name}}</p>
					</div>
					{{if .ShowAutoWatchOrgRepos}}
						<label>
							<input name="auto_watch_org_repos" type="checkbox" {{if .AutoWatchNewRepos}}checked{{end}}>
								{{ctx.Locale.Tr "org.teams.invite.auto_watch_org_repos"}}
								<span class="help">{{ctx.Locale.Tr "org.teams.invite.auto_watch_org_repos_description"}}</span>
						</label>
					{{end}}
					<button class="ui primary button">{{ctx.Locale.Tr "org.teams.join"}}</button>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
