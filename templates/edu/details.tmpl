{{template "base/head" .}}
<div role="main" aria-label="{{.Assignment.Title}}" class="page-content edu-assignment-details">
	<div class="ui container">
		<div class="ui grid">
			<div class="twelve wide column">
				<h1 class="ui header">
					{{.Assignment.Title}}
					<div class="sub header">{{.Assignment.Deadline}}</div>
				</h1>
				<div class="ui segment">
					{{.Assignment.Description | SafeHTML}}
				</div>
			</div>
			<div class="four wide column">
				<div class="ui card">
					<div class="content">
						<div class="header">{{.locale.Tr "edu.status"}}</div>
					</div>
					<div class="content">
						{{if .Submission}}
							<div class="ui {{if eq .Submission.Status "passed"}}green{{else}}yellow{{end}} label">
								{{.Submission.Status}}
							</div>
							{{if .TestResult}}
								<div class="ui divider"></div>
								<p>Score: {{.TestResult.Score}}</p>
							{{end}}
						{{else}}
							<p>{{.locale.Tr "edu.not_started"}}</p>
						{{end}}
					</div>
					<div class="extra content">
						{{if not .Submission}}
						<form action="{{AppSubUrl}}/edu/assignments/{{.Assignment.ID}}/start" method="post">
							{{.CsrfTokenHtml}}
							<button class="ui fluid teal button">{{.locale.Tr "edu.start_assignment"}}</button>
						</form>
						{{else}}
						<a href="{{.SubmissionRepoLink}}" class="ui fluid primary button">{{.locale.Tr "edu.go_to_repo"}}</a>
						{{end}}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
