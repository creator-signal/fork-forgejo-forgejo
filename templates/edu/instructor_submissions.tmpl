{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu instructor-submissions">
	<div class="ui container">
		{{template "edu/navbar" .}}

		<div class="ui grid">
			<div class="sixteen wide column">
				<div class="ui secondary menu">
					<div class="header item">
						<h1 class="ui header" style="margin:0">
							{{.Assignment.Title}} - {{ctx.Locale.Tr "edu.submissions"}}
						</h1>
					</div>
					<div class="right menu">
						<form action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/bulk-fork" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui teal button" onclick="return confirm('{{ctx.Locale.Tr "edu.fork_confirm"}}')">
								{{svg "octicon-repo-forked"}} {{ctx.Locale.Tr "edu.fork_for_all"}}
							</button>
						</form>
						<form action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/sync-forks" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui olive button" onclick="return confirm('{{ctx.Locale.Tr "edu.sync_confirm"}}')">
								{{svg "octicon-sync"}} {{ctx.Locale.Tr "edu.sync_all_forks"}}
							</button>
						</form>
						<a class="ui button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/edit" style="margin-left: 5px;">
							{{svg "octicon-pencil"}} {{ctx.Locale.Tr "edu.edit_assignment"}}
						</a>
						<form action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/delete" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui red button" onclick="return confirm('{{ctx.Locale.Tr "edu.delete_assignment_confirm"}}')">
								{{svg "octicon-trash"}} {{ctx.Locale.Tr "edu.delete"}}
							</button>
						</form>
					</div>
				</div>

				<div class="ui segment">
					<table class="ui celled table">
						<thead>
							<tr>
								<th>{{ctx.Locale.Tr "edu.student"}}</th>
								<th>{{ctx.Locale.Tr "edu.status"}}</th>
								<th>{{ctx.Locale.Tr "edu.ci_score"}}</th>
								<th>{{ctx.Locale.Tr "edu.grade"}}</th>
								<th>{{ctx.Locale.Tr "edu.repo"}}</th>
								<th>{{ctx.Locale.Tr "edu.updated"}}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{{range .Submissions}}
								<tr>
									<td>
										{{with (index $.UserMap .UserID)}}
											{{.Name}}
										{{else}}
											User {{.UserID}}
										{{end}}
									</td>
									<td>
										<span class="ui label {{if eq (printf "%s" .Status) "passed"}}green{{else if eq (printf "%s" .Status) "failed"}}red{{else if eq (printf "%s" .Status) "submitted"}}blue{{else if eq (printf "%s" .Status) "graded"}}purple{{else}}grey{{end}}">
											{{.Status}}
										</span>
									</td>
									<td>
										{{with (index $.TestResultMap .ID)}}
											<span class="ui label {{if ge .Score 50}}green{{else}}red{{end}}">
												{{.Score}}%
											</span>
											<small title="{{.CommitSHA}}">{{slice .CommitSHA 0 7}}</small>
										{{else}}
											<span class="ui grey label">—</span>
										{{end}}
									</td>
									<td>
										{{if .IsGraded}}
											<span class="ui purple label">{{.Grade}}/100</span>
										{{else}}
											<span class="ui grey label">{{ctx.Locale.Tr "edu.not_graded"}}</span>
										{{end}}
									</td>
									<td>
										{{with (index $.RepoLinkMap .ID)}}<a href="{{AppSubUrl}}/{{.}}">{{ctx.Locale.Tr "edu.repo"}}</a>{{end}}
									</td>
									<td>{{(DateUtils).AbsoluteShort .UpdatedUnix}}</td>
									<td>
										<a class="ui mini button" href="{{AppSubUrl}}/edu/teacher/assignments/{{$.Assignment.ID}}/submissions/{{.ID}}">
											{{svg "octicon-eye"}} {{ctx.Locale.Tr "edu.detail"}}
										</a>
									</td>
								</tr>
							{{else}}
								<tr>
									<td colspan="7">{{ctx.Locale.Tr "edu.no_submissions_yet"}}</td>
								</tr>
							{{end}}
						</tbody>
					</table>
				</div>
			</div>

				{{if .BulkForkTask}}
				<div class="ui segment">
					<h4>{{svg "octicon-sync"}} {{ctx.Locale.Tr "edu.bulk_fork_status"}}</h4>
					<div class="ui indicating progress" data-total="{{.BulkForkTask.TotalUsers}}" data-value="{{.BulkForkTask.Completed}}">
						<div class="bar"><div class="progress"></div></div>
						<div class="label">
							{{.BulkForkTask.Completed}}/{{.BulkForkTask.TotalUsers}} {{ctx.Locale.Tr "edu.completed"}}
							{{if .BulkForkTask.Failed}}, {{.BulkForkTask.Failed}} {{ctx.Locale.Tr "edu.failed"}}{{end}}
							— {{.BulkForkTask.Status}}
						</div>
					</div>
					{{if .BulkForkTask.ErrorLog}}
					<details>
						<summary class="ui red text">{{ctx.Locale.Tr "edu.error_log"}}</summary>
						<pre>{{.BulkForkTask.ErrorLog}}</pre>
					</details>
					{{end}}
				</div>
				{{end}}

				{{if .SyncForkTask}}
				<div class="ui segment">
					<h4>{{svg "octicon-sync"}} {{ctx.Locale.Tr "edu.last_sync_status"}}</h4>
					<div class="ui indicating progress" data-total="{{.SyncForkTask.TotalRepos}}" data-value="{{.SyncForkTask.Synced}}">
						<div class="bar"><div class="progress"></div></div>
						<div class="label">
							{{ctx.Locale.Tr "edu.synced"}}: {{.SyncForkTask.Synced}},
							{{ctx.Locale.Tr "edu.skipped"}}: {{.SyncForkTask.Skipped}},
							{{ctx.Locale.Tr "edu.failed"}}: {{.SyncForkTask.Failed}}
							— {{.SyncForkTask.Status}}
						</div>
					</div>
					{{if .SyncForkTask.ErrorLog}}
					<details>
						<summary class="ui red text">{{ctx.Locale.Tr "edu.error_log"}}</summary>
						<pre>{{.SyncForkTask.ErrorLog}}</pre>
					</details>
					{{end}}
				</div>
				{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
