{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu submission-detail">
	<div class="ui container">
		{{template "edu/navbar" .}}

		<h1 class="ui header">
			{{svg "octicon-git-pull-request" 28}}
			{{ctx.Locale.Tr "edu.submission_detail"}}
		</h1>

		<div class="ui segment">
			<p><strong>{{ctx.Locale.Tr "edu.assignment"}}:</strong> {{.Assignment.Title}}</p>
			<p><strong>{{ctx.Locale.Tr "edu.student"}}:</strong> {{if .Student}}{{.Student.Name}}{{else}}User #{{.Submission.UserID}}{{end}}</p>
			<p><strong>{{ctx.Locale.Tr "edu.status"}}:</strong>
				<span class="ui label {{if eq (printf "%s" .Submission.Status) "passed"}}green{{else if eq (printf "%s" .Submission.Status) "failed"}}red{{else if eq (printf "%s" .Submission.Status) "graded"}}purple{{else if eq (printf "%s" .Submission.Status) "submitted"}}blue{{else}}grey{{end}}">
					{{.Submission.Status}}
				</span>
			</p>
			{{if .Submission.StudentRepoID}}
				<p><strong>{{ctx.Locale.Tr "edu.repo"}}:</strong> <a href="{{AppSubUrl}}/repositories/{{.Submission.StudentRepoID}}">{{ctx.Locale.Tr "edu.open_repo"}}</a></p>
			{{end}}
		</div>

		<!-- CI/CD Test Results -->
		<h2 class="ui header">{{svg "octicon-check-circle"}} {{ctx.Locale.Tr "edu.ci_test_results"}}</h2>
		<div class="ui segment">
			{{if .TestResults}}
				<table class="ui celled table">
					<thead>
						<tr>
							<th>#</th>
							<th>{{ctx.Locale.Tr "edu.commit"}}</th>
							<th>{{ctx.Locale.Tr "edu.score"}}</th>
							<th>{{ctx.Locale.Tr "edu.details"}}</th>
							<th>{{ctx.Locale.Tr "edu.date"}}</th>
						</tr>
					</thead>
					<tbody>
						{{range $i, $tr := .TestResults}}
							<tr>
								<td>{{$tr.ID}}</td>
								<td><code>{{slice $tr.CommitSHA 0 7}}</code></td>
								<td>
									<span class="ui label {{if ge $tr.Score 50}}green{{else}}red{{end}}">
										{{$tr.Score}}%
									</span>
								</td>
								<td>{{$tr.Details | SanitizeHTML}}</td>
								<td>{{(DateUtils).AbsoluteShort $tr.CreatedUnix}}</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{else}}
				<p>{{ctx.Locale.Tr "edu.no_test_results"}}</p>
			{{end}}
		</div>

		<!-- Grading -->
		<h2 class="ui header">{{svg "octicon-star"}} {{ctx.Locale.Tr "edu.grading"}}</h2>
		<div class="ui segment">
			{{if .Submission.IsGraded}}
				<div class="ui message">
					<p>{{ctx.Locale.Tr "edu.current_grade"}}: <span class="ui large purple label">{{.Submission.Grade}}/100</span></p>
					{{if .Submission.Comment}}
						<p><strong>{{ctx.Locale.Tr "edu.comment"}}:</strong> {{.Submission.Comment | SanitizeHTML}}</p>
					{{end}}
					{{if .Grader}}
						<p><small>{{ctx.Locale.Tr "edu.graded_by"}} {{.Grader.Name}} — {{(DateUtils).AbsoluteShort .Submission.GradedUnix}}</small></p>
					{{end}}
				</div>
			{{end}}

			<form class="ui form" action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/submissions/{{.Submission.ID}}/grade" method="post">
				{{.CsrfTokenHtml}}
				<div class="field">
					<label>{{ctx.Locale.Tr "edu.grade_range"}}</label>
					<input type="number" name="grade" min="0" max="100" value="{{if .Submission.IsGraded}}{{.Submission.Grade}}{{end}}" required>
				</div>
				<div class="field">
					<label>{{ctx.Locale.Tr "edu.comment"}}</label>
					<textarea name="comment" rows="3">{{.Submission.Comment}}</textarea>
				</div>
				<button class="ui primary button" type="submit">{{svg "octicon-check"}} {{ctx.Locale.Tr "edu.save_grade"}}</button>
			</form>
		</div>

		<div style="margin-top: 15px;">
			<a class="ui button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/submissions">
				{{svg "octicon-arrow-left"}} {{ctx.Locale.Tr "edu.back_to_submissions"}}
			</a>
		</div>
	</div>
</div>
{{template "base/footer" .}}
