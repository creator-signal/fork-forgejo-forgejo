{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new repo">
	<div class="ui middle aligned center aligned grid">
		<div class="column">
			<form class="ui form" action="{{.Link}}" method="post">
				{{.CsrfTokenHtml}}
				<h3 class="ui top attached header">
					{{.Title}}
				</h3>
				<div class="ui attached segment">
					{{template "base/alert" .}}
					
                    <div class="required field {{if .Err_Title}}error{{end}}">
						<label for="title">{{.locale.Tr "Title"}}</label>
						<input id="title" name="title" value="{{.title}}" autofocus required>
					</div>

                    <div class="field {{if .Err_Description}}error{{end}}">
						<label for="description">{{.locale.Tr "Description"}}</label>
						<textarea id="description" name="description">{{.description}}</textarea>
					</div>

                    <div class="required field {{if .Err_TemplateRepo}}error{{end}}">
						<label for="template_repo">{{.locale.Tr "Template Repository Name"}} (e.g. 'homework-1')</label>
						<span class="help">The repository must be owned by you.</span>
                        <input id="template_repo" name="template_repo" value="{{.template_repo}}" required>
					</div>

                    <div class="field {{if .Err_Deadline}}error{{end}}">
						<label for="deadline">{{.locale.Tr "Deadline"}}</label>
						<input id="deadline" name="deadline" type="datetime-local" value="{{.deadline}}">
					</div>

					<div class="inline field">
						<button class="ui primary button">{{.locale.Tr "Create Assignment"}}</button>
						<a class="ui button" href="{{AppSubUrl}}/edu/assignments">{{.locale.Tr "Cancel"}}</a>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
