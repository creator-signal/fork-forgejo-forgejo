{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu assignments">
	<div class="ui container">
		<div class="ui grid">
			<div class="column">
				<div class="ui secondary menu">
					<div class="header item">
						<h1 class="ui header" style="margin:0">
							{{svg "octicon-mortar-board" 32}}
							{{.Title}}
						</h1>
					</div>
					<div class="right menu">
						<a class="ui positive button" href="{{AppSubUrl}}/edu/teacher/assignments/new">
							{{svg "octicon-plus"}}
							{{ctx.Locale.Tr "edu.new_assignment"}}
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="ui secondary pointing menu">
			<a class="active item" href="{{AppSubUrl}}/edu/teacher/assignments">Assignments</a>
			<a class="item" href="{{AppSubUrl}}/edu/teacher/courses">Courses</a>
		</div>

		<div class="ui divider"></div>

		{{if .Assignments}}
			<div class="ui three stackable cards">
				{{range .Assignments}}
					<div class="ui fluid card">
						<div class="content">
							<div class="header">
								<a href="{{AppSubUrl}}/edu/teacher/assignments/{{.ID}}/submissions">{{.Title}}</a>
							</div>
							<div class="meta">
								{{if .CourseID}}
									{{with (index $.CourseMap .CourseID)}}
										<span class="ui tiny blue label">{{.Name}}</span>
									{{end}}
								{{end}}
								<span class="date">{{if .DeadlineUnix}}{{svg "octicon-clock"}} {{.Deadline.Format "02 Jan 2006"}}{{else}}No Deadline{{end}}</span>
							</div>
							<div class="description">
								{{.Description | SafeHTML}}
							</div>
						</div>
						<div class="extra content">
							<a class="ui primary button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.ID}}/submissions">
								{{svg "octicon-eye"}} Submissions
							</a>
							<a class="ui button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.ID}}/edit">
								{{svg "octicon-pencil"}} Edit
							</a>
						</div>
					</div>
				{{end}}
			</div>
		{{else}}
			<div class="ui placeholder segment">
				<div class="ui icon header">
					{{svg "octicon-repo"}}
					{{ctx.Locale.Tr "edu.no_assignments"}}
				</div>
				<a class="ui primary button" href="{{AppSubUrl}}/edu/teacher/assignments/new">{{ctx.Locale.Tr "edu.create_first_assignment"}}</a>
			</div>
		{{end}}
	</div>
</div>
<style>
	.edu.assignments .card {
		box-shadow: 0 4px 6px rgba(0,0,0,0.1);
		transition: transform 0.2s;
	}
	.edu.assignments .card:hover {
		transform: translateY(-5px);
	}
</style>
{{template "base/footer" .}}
