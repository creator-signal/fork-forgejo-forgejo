{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu course-detail">
	<div class="ui container">
		{{template "edu/navbar" .}}
		{{template "base/alert" .}}

		<div class="ui grid">
			<div class="sixteen wide column">
				<div class="ui secondary menu">
					<div class="header item">
						<h1 class="ui header" style="margin:0">
							{{svg "octicon-mortar-board" 28}}
							{{.Course.Name}}
						</h1>
					</div>
					<div class="right menu">
						<a class="ui button" href="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/edit">
							{{svg "octicon-pencil"}} {{ctx.Locale.Tr "edu.edit"}}
						</a>
						<form action="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/delete" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui red button" onclick="return confirm('{{ctx.Locale.Tr "edu.delete_course_confirm"}}')">
								{{svg "octicon-trash"}} {{ctx.Locale.Tr "edu.delete"}}
							</button>
						</form>
					</div>
				</div>

				<div class="ui segment">
					{{if .Course.Description}}
						<p>{{.Course.Description | SanitizeHTML}}</p>
					{{end}}
					{{if .Course.StartUnix}}
						<p><strong>{{ctx.Locale.Tr "edu.start_date"}}:</strong> {{.Course.StartDate.Format "02 Jan 2006 15:04"}}</p>
					{{end}}
					{{if .Course.EndUnix}}
						<p><strong>{{ctx.Locale.Tr "edu.end_date"}}:</strong> {{.Course.EndDate.Format "02 Jan 2006 15:04"}}</p>
					{{end}}
					{{if .Course.IsActive}}
						<span class="ui green label">{{ctx.Locale.Tr "edu.active"}}</span>
					{{else}}
						<span class="ui red label">{{ctx.Locale.Tr "edu.ended"}}</span>
					{{end}}
				</div>

				<!-- Assignments -->
				<h2 class="ui header">
					{{svg "octicon-tasklist"}} {{ctx.Locale.Tr "edu.assignments"}}
					<a class="ui small primary button" href="{{AppSubUrl}}/edu/teacher/assignments/new?course_id={{.Course.ID}}" style="margin-left: 10px;">
						{{svg "octicon-plus"}} {{ctx.Locale.Tr "edu.new_assignment"}}
					</a>
				</h2>
				<div class="ui segment">
					{{if .Assignments}}
						<div class="ui divided list">
							{{range .Assignments}}
								<div class="item">
									<div class="content">
										<a class="header" href="{{AppSubUrl}}/edu/teacher/assignments/{{.ID}}/submissions">
											{{.Title}}
											{{with (index $.SubmissionCounts .ID)}}
												<span class="ui mini label">{{.}} submissions</span>
											{{end}}
										</a>
										<div class="description">
											{{if .DeadlineUnix}}{{svg "octicon-clock"}} {{.Deadline.Format "02 Jan 2006"}}{{end}}
										</div>
									</div>
								</div>
							{{end}}
						</div>
					{{else}}
						<p>{{ctx.Locale.Tr "edu.no_assignments_in_course"}}</p>
					{{end}}
				</div>

				<!-- Enrollments -->
				<h2 class="ui header">
					{{svg "octicon-people"}} {{ctx.Locale.Tr "edu.participants"}}
					<a class="ui small teal button" href="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/import" style="margin-left: 10px;">
						{{svg "octicon-upload"}} {{ctx.Locale.Tr "edu.import_csv"}}
					</a>
				</h2>
				<div class="ui segment">
					<form class="ui form" action="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/enroll" method="post">
						{{.CsrfTokenHtml}}
						<div class="ui action input" style="margin-bottom: 15px;">
							<input type="text" name="username" placeholder="{{ctx.Locale.Tr "edu.username"}}" required>
							<select class="ui compact selection dropdown" name="role">
								<option value="student">{{ctx.Locale.Tr "edu.student"}}</option>
								<option value="teacher">{{ctx.Locale.Tr "edu.teacher"}}</option>
							</select>
							<button class="ui primary button" type="submit">{{svg "octicon-plus"}} {{ctx.Locale.Tr "edu.add"}}</button>
						</div>
					</form>

					{{if .Enrollments}}
						<table class="ui celled table">
							<thead>
								<tr>
									<th>{{ctx.Locale.Tr "edu.username"}}</th>
									<th>{{ctx.Locale.Tr "edu.role"}}</th>
									<th>{{ctx.Locale.Tr "edu.enrolled"}}</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								{{range .Enrollments}}
									<tr>
										<td>
											{{with (index $.UserMap .UserID)}}
												{{.Name}}
											{{else}}
												User #{{.UserID}}
											{{end}}
										</td>
										<td>
											{{if eq (printf "%s" .Role) "teacher"}}
												<span class="ui blue label">{{ctx.Locale.Tr "edu.teacher"}}</span>
											{{else if eq (printf "%s" .Role) "admin"}}
												<span class="ui purple label">{{ctx.Locale.Tr "edu.admin"}}</span>
											{{else}}
												<span class="ui teal label">{{ctx.Locale.Tr "edu.student"}}</span>
											{{end}}
										</td>
										<td>{{(DateUtils).AbsoluteShort .CreatedUnix}}</td>
										<td>
											<form action="{{AppSubUrl}}/edu/teacher/courses/{{$.Course.ID}}/unenroll" method="post" style="display:inline">
												{{$.CsrfTokenHtml}}
												<input type="hidden" name="user_id" value="{{.UserID}}">
												<button class="ui mini red button">{{svg "octicon-x"}} {{ctx.Locale.Tr "edu.remove"}}</button>
											</form>
										</td>
									</tr>
								{{end}}
							</tbody>
						</table>
					{{else}}
						<p>{{ctx.Locale.Tr "edu.no_participants"}}</p>
					{{end}}
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
