{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu import-result">
	<div class="ui container">
		<h1 class="ui header">
			{{svg "octicon-check-circle" 28}}
			{{ctx.Locale.Tr "edu.import_complete"}}
		</h1>
		<p>{{ctx.Locale.Tr "edu.course"}}: <strong>{{.Course.Name}}</strong></p>

		<div class="ui four statistics">
			<div class="statistic">
				<div class="value">{{.Result.TotalRows}}</div>
				<div class="label">{{ctx.Locale.Tr "edu.total_rows"}}</div>
			</div>
			<div class="green statistic">
				<div class="value">{{.Result.Created}}</div>
				<div class="label">{{ctx.Locale.Tr "edu.created"}}</div>
			</div>
			<div class="blue statistic">
				<div class="value">{{.Result.AlreadyExist}}</div>
				<div class="label">{{ctx.Locale.Tr "edu.already_existed"}}</div>
			</div>
			<div class="red statistic">
				<div class="value">{{.Result.Errors}}</div>
				<div class="label">{{ctx.Locale.Tr "edu.errors"}}</div>
			</div>
		</div>

		{{if .Result.Credentials}}
			<h2 class="ui header" style="margin-top: 20px;">{{ctx.Locale.Tr "edu.generated_credentials"}}</h2>
			<div class="ui warning message">
				<p>{{ctx.Locale.Tr "edu.credentials_warning"}}</p>
			</div>
			<div class="ui segment" style="overflow-x: auto;">
				<table class="ui celled table" id="credentials-table">
					<thead>
						<tr>
							<th>{{ctx.Locale.Tr "edu.username"}}</th>
							<th>{{ctx.Locale.Tr "edu.password"}}</th>
							<th>{{ctx.Locale.Tr "edu.full_name"}}</th>
							<th>{{ctx.Locale.Tr "edu.email"}}</th>
						</tr>
					</thead>
					<tbody>
						{{range .Result.Credentials}}
							<tr>
								<td>{{.Username}}</td>
								<td><code>{{.Password}}</code></td>
								<td>{{.FullName}}</td>
								<td>{{.Email}}</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
			<button class="ui teal button" onclick="downloadCredentialsCSV()">
				{{svg "octicon-download"}} {{ctx.Locale.Tr "edu.download_csv"}}
			</button>
			<script>
				function downloadCredentialsCSV() {
					const table = document.getElementById('credentials-table');
					const rows = table.querySelectorAll('tr');
					let csv = '';
					rows.forEach(function(row) {
						const cells = row.querySelectorAll('th, td');
						const values = [];
						cells.forEach(function(cell) {
							values.push('"' + cell.textContent.trim().replace(/"/g, '""') + '"');
						});
						csv += values.join(',') + '\n';
					});
					const blob = new Blob([csv], {type: 'text/csv'});
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = 'credentials.csv';
					a.click();
					URL.revokeObjectURL(url);
				}
			</script>
		{{end}}

		<div style="margin-top: 20px;">
			<a class="ui primary button" href="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}">
				{{svg "octicon-arrow-left"}} {{ctx.Locale.Tr "edu.back_to_course"}}
			</a>
		</div>
	</div>
</div>
{{template "base/footer" .}}
