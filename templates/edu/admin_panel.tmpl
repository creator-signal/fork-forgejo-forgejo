{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu admin-panel">
	<div class="ui container">
		<div class="ui secondary pointing menu">
			<a class="active item" href="{{AppSubUrl}}/edu/admin">{{ctx.Locale.Tr "edu.roles"}}</a>
		</div>

		<div class="ui segment">
			<h3 class="ui header">{{ctx.Locale.Tr "edu.manage_roles"}}</h3>
			<div class="ui info message">
				<p>{{ctx.Locale.Tr "edu.manage_roles_desc"}}</p>
			</div>

			<form class="ui form" action="{{AppSubUrl}}/edu/admin/roles" method="post">
				{{.CsrfTokenHtml}}
				<div class="field">
					<label>{{ctx.Locale.Tr "edu.username"}}</label>
					<div class="ui action input">
						<input type="text" name="username" placeholder="e.g. user1" required>
						<select class="ui selection dropdown" name="role">
							<option value="student">{{ctx.Locale.Tr "edu.student"}}</option>
							<option value="teacher">{{ctx.Locale.Tr "edu.teacher"}}</option>
						</select>
						<button class="ui primary button">{{ctx.Locale.Tr "edu.set_role"}}</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
