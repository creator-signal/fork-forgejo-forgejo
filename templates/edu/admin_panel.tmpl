{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu admin-panel">
	<div class="ui container">
		<div class="ui secondary pointing menu">
			<a class="active item" href="{{AppSubUrl}}/edu/admin">{{.locale.Tr "Roles"}}</a>
		</div>

		<div class="ui segment">
			<h3 class="ui header">{{.locale.Tr "Manage User Roles"}}</h3>
			<div class="ui info message">
				<p>{{.locale.Tr "Assign global roles to users. Teachers can create assignments. Students can view and join assignments."}}</p>
			</div>

			<form class="ui form" action="{{AppSubUrl}}/edu/admin/roles" method="post">
				{{.CsrfTokenHtml}}
				<div class="field">
					<label>{{.locale.Tr "Username"}}</label>
					<div class="ui action input">
						<input type="text" name="username" placeholder="e.g. user1" required>
						<select class="ui selection dropdown" name="role">
							<option value="student">{{.locale.Tr "Student"}}</option>
							<option value="teacher">{{.locale.Tr "Teacher"}}</option>
						</select>
						<button class="ui primary button">{{.locale.Tr "Set Role"}}</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
