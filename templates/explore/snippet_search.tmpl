<div class="list-header">
	<form class="ui form ignore-dirty list-header-search">
		{{if .PageIsProfileSnippetList}}
			<input type="hidden" name="tab" value="snippets" />
		{{end}}
		{{if .SortType}}
			<input type="hidden" name="sort" value="{{.SortType}}" />
		{{end}}
		{{if .Language}}
			<input type="hidden" name="language" value="{{.Language}}" />
		{{end}}

		{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.snippet_kind")}}
	</form>
	<div class="button-row">
		<!-- Sort -->
		<details class="dropdown dir-rtl">
			<summary class="options">
				{{ctx.Locale.Tr "repo.issues.filter_sort"}}
				{{svg "octicon-triangle-down" 14}}
			</summary>
			<div class="content">
				<ul>
					<li>
						<a class="{{if eq .SortType "newest"}}active{{end}}" href="?sort=newest{{if .PageIsProfileSnippetList}}&tab=snippets{{end}}{{if .Keyword}}&q={{.Keyword}}{{end}}{{if .Language}}&language={{.Language}}{{end}}">{{ctx.Locale.Tr "repo.issues.filter_sort.latest"}}</a>
					</li>
					<li>
						<a class="{{if eq .SortType "oldest"}}active{{end}}" href="?sort=oldest{{if .PageIsProfileSnippetList}}&tab=snippets{{end}}{{if .Keyword}}&q={{.Keyword}}{{end}}{{if .Language}}&language={{.Language}}{{end}}">{{ctx.Locale.Tr "repo.issues.filter_sort.oldest"}}</a>
					</li>
					<li>
						<a class="{{if eq .SortType "alphabetically"}}active{{end}}" href="?sort=alphabetically{{if .PageIsProfileSnippetList}}&tab=snippets{{end}}{{if .Keyword}}&q={{.Keyword}}{{end}}{{if .Language}}&language={{.Language}}{{end}}">{{ctx.Locale.Tr "repo.issues.label.filter_sort.alphabetically"}}</a>
					</li>
					<li>
						<a class="{{if eq .SortType "reversealphabetically"}}active{{end}}" href="?sort=reversealphabetically{{if .PageIsProfileSnippetList}}&tab=snippets{{end}}{{if .Keyword}}&q={{.Keyword}}{{end}}{{if .Language}}&language={{.Language}}{{end}}">{{ctx.Locale.Tr "repo.issues.label.filter_sort.reverse_alphabetically"}}</a>
					</li>
				</ul>
			</div>
		</details>
	</div>
</div>
<div class="divider"></div>
