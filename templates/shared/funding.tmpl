<dialog closedby="any" id="sponsor-modal" aria-labelledby="sponsor-modal-header">
	<article>
		<header>
			<span role="heading" aria-level="1" id="sponsor-modal-header">{{ctx.Locale.Tr "funding.sponsor_header" .FundingTarget}}</span>
			<button type="button" commandfor="sponsor-modal" command="close" aria-label="Close" class="toast-close">{{svg "octicon-x" 24}}</button>
		</header>
		<div class="content">
			{{if .FundingHasErrors}}
			<div class="ui error message">
				{{ctx.Locale.Tr "funding.sponsor_parsing_errors" .FundingConfig}}
			</div>
			{{end}}
			<ul class="tw-list-none tw-p-0">
				{{range .Funding}}
				<li class="tw-flex tw-flex-nowrap tw-items-center tw-gap-2 tw-mb-4">
					<div class="icon" role="img" aria-label="{{.ProviderName}}">
					{{if eq .ProviderName "buy_me_a_coffee" "community_bridge" "github" "issuehunt" "ko_fi" "liberapay" "open_collective" "patreon" "polar" "thanks_dev"}}
						{{$iconName := (print "brand-" .ProviderName)}}
						{{svg $iconName 22 "brand-color"}}
					{{else if eq .ProviderName "custom"}}
						{{svg "octicon-link" 22}}
					{{else}}
						{{svg "octicon-heart" 22}}
					{{end}}
					</div>
					<a rel="noopener" href="{{.URL}}">{{.Text}}</a>
				</li>
				{{end}}
			</ul>
		</div>
	</article>
</dialog>
