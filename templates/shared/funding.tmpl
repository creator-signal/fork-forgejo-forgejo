<dialog closedby="any" id="sponsor-modal" aria-labelledby="sponsor-modal-header">
	<article>
		<header>
			<span role="heading" aria-level="1" id="sponsor-modal-header">{{ctx.Locale.Tr "funding.sponsor_header" .FundingTarget}}</span>
			<button type="button" commandfor="sponsor-modal" command="close" aria-label="Close" class="toast-close">{{svg "octicon-x" 24}}</button>
		</header>
		<div class="content">
			{{if .FundingHasErrors}}
			<div class="ui error message">
				{{ctx.Locale.Tr "funding.sponsor_parsing_errors" .FundingConfig}}
			</div>
			{{end}}
			<ul class="tw-list-none tw-p-0">
				{{range .Funding}}
				<li class="tw-flex tw-gap-2 tw-mb-4">
					{{if eq .ProviderName "custom"}}
						{{/* we render this svg directly, rather than relying on the configured img src, for better color theming */}}
						{{/* TODO: alt-text */}}
						{{svg "octicon-link" 24 "funding-logo"}}
					{{else if .Icon}}
						<picture class="funding-logo {{.ProviderName}}">
							{{if .IconDark}}
							<source srcset="{{.IconDark}}" media="(prefers-color-scheme: dark)" />
							{{end}}
							<img src="{{.Icon}}" alt="{{.ProviderName}}" width="24" height="24">
						</picture>
					{{else}}
						{{svg "octicon-heart" 24 "funding-logo"}}
					{{end}}
					<a rel="noopener" href="{{.URL}}">{{.Text}}</a>
				</li>
				{{end}}
			</ul>
		</div>
	</article>
</dialog>
