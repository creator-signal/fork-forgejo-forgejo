<dialog closedby="any" id="sponsor-modal">
	<article>
		<header>
		{{if .FundingRepo}}
			{{ctx.Locale.Tr "funding.sponsor_repo_header" .FundingOwner .FundingRepo}}
		{{else}}
			{{ctx.Locale.Tr "funding.sponsor_user_header" .FundingOwner}}
		{{end}}
			<button type="button" commandfor="sponsor-modal" command="close" aria-label="Close" class="ui button mini compact basic icon close-dialog">{{svg "octicon-x" 24}}</button>
		</header>
		<div class="content">
			<ul class="tw-list-none tw-p-0">
				{{range .Funding}}
				<li class="tw-flex tw-gap-2 tw-mb-4">
					{{if eq .ProviderName "custom"}}
						{{/* we render this svg directly, rather than relying on the configured img src, for better color theming */}}
						{{/* TODO: alt-text */}}
						{{svg "octicon-link" 24}}
					{{else if .Icon}}
						{{/* TODO: proper alt-text */}}
						<img class="tw-h-full" src="{{.Icon}}" alt="" width="24" height="24">
					{{else}}
						{{svg "octicon-heart" 24}}
					{{end}}
					<a target="_blank" rel="noopener noreferrer" href="{{.URL}}">{{.Text}}</a>
				</li>
				{{end}}
			</ul>
		</div>
	</article>
</dialog>
