{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "user settings notifications")}}
	<div class="user-setting-content">

		{{if $.EnableNotifyMail}}
		<!-- Email Notifications -->
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "settings.email_notifications"}}
		</h4>
		<div class="ui attached segment">
			<form action="{{AppSubUrl}}/user/settings/notifications" class="ui form" method="post">
				{{$.CsrfTokenHtml}}
				<input name="_method" type="hidden" value="EMAIL_PREFERENCE">
				<div class="tw-mb-4">{{ctx.Locale.Tr "settings.email_notifications_desc"}}</div>
				<div class="tw-flex tw-flex-wrap tw-gap-2">
					<div class="ui selection dropdown">
						<input name="preference" type="hidden" value="{{.EmailNotificationsPreference}}">
						{{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="text"></div>
						<div class="menu">
							<div data-value="enabled" class="{{if eq .EmailNotificationsPreference "enabled"}}active selected {{end}}item">{{ctx.Locale.Tr "settings.email_notifications.enable"}}</div>
							<div data-value="andyourown" class="{{if eq .EmailNotificationsPreference "andyourown"}}active selected {{end}}item">{{ctx.Locale.Tr "settings.email_notifications.andyourown"}}</div>
							<div data-value="onmention" class="{{if eq .EmailNotificationsPreference "onmention"}}active selected {{end}}item">{{ctx.Locale.Tr "settings.email_notifications.onmention"}}</div>
							<div data-value="disabled" class="{{if eq .EmailNotificationsPreference "disabled"}}active selected {{end}}item">{{ctx.Locale.Tr "settings.email_notifications.disable"}}</div>
						</div>
					</div>
					<button class="ui primary button">{{ctx.Locale.Tr "settings.email_notifications.submit"}}</button>
				</div>
			</form>
		</div>
		{{end}}

		<!-- Auto-Watch Repositories -->
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "settings.auto_watch_repos"}}
		</h4>
		<div class="ui attached segment">
			<div class="tw-mb-4 tw-text-text-light-2">{{ctx.Locale.Tr "settings.auto_watch_repos_desc"}}</div>
			<form action="{{AppSubUrl}}/user/settings/notifications" class="ui form" method="post">
				{{$.CsrfTokenHtml}}
				<input name="_method" type="hidden" value="AUTO_WATCH">
				<div class="field">
					<div class="ui checkbox">
						<input type="checkbox" name="auto_watch_on_create" {{if .AutoWatchOnCreate}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.auto_watch_repos.on_create"}}</label>
					</div>
				</div>
				<div class="field">
					<div class="ui checkbox">
						<input type="checkbox" name="auto_watch_on_access" {{if .AutoWatchOnAccess}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.auto_watch_repos.on_access"}}</label>
					</div>
				</div>
				<div class="field">
					<div class="ui checkbox">
						<input type="checkbox" name="auto_watch_on_contribute" {{if .AutoWatchOnContribute}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.auto_watch_repos.on_contribute"}}</label>
					</div>
				</div>
				<div class="tw-mt-4">
					<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
				</div>
			</form>
		</div>

		<!-- Default Watch Events -->
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "settings.default_watch_events"}}
		</h4>
		<div class="ui attached segment">
			<div class="tw-mb-2 tw-text-text-light-2">{{ctx.Locale.Tr "settings.default_watch_events_desc"}}</div>
			<form action="{{AppSubUrl}}/user/settings/notifications" class="ui form" method="post">
				{{$.CsrfTokenHtml}}
				<input name="_method" type="hidden" value="WATCH_DEFAULTS">
				<div class="tw-flex tw-flex-wrap tw-gap-4 tw-mb-4">
					<div class="ui checkbox">
						<input type="checkbox" name="watch_issues" {{if .DefaultWatchIssues}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.default_watch_events.issues"}}</label>
					</div>
					<div class="ui checkbox">
						<input type="checkbox" name="watch_pulls" {{if .DefaultWatchPulls}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.default_watch_events.pull_requests"}}</label>
					</div>
					<div class="ui checkbox">
						<input type="checkbox" name="watch_releases" {{if .DefaultWatchReleases}}checked{{end}}>
						<label>{{ctx.Locale.Tr "settings.default_watch_events.releases"}}</label>
					</div>
				</div>
				<button class="ui primary button">{{ctx.Locale.Tr "settings.default_watch_events.submit"}}</button>
			</form>
		</div>

	</div>
{{template "user/settings/layout_footer" .}}
