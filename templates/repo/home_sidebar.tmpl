<div class="flex-item">
	<div class="flex-item-main">
		<div class="flex-item-title">
			<a class="item muted" href="{{.RepoLink}}/releases">
				{{ctx.Locale.Tr "repo.releases"}}
				{{if .NumReleases}}
					<span class="ui small label">{{CountFmt .NumReleases}}</span>
				{{end}}
			</a>
		</div>
		<div class="flex-item tw-pb-2">
			<div class="flex-item-icon">
				{{svg "octicon-tag"}}
			</div>
			<div class="flex-item-main">
				<div class="flex-item-header">
					<div class="flex-item-title tw-gap-2">
						<a class="gt-ellipsis muted" href="{{.RepoLink}}/releases/" title="V0.2.0">V0.2.0</a>
						<span class="ui green label">{{ctx.Locale.Tr "release.latest"}}</span>
					</div>
				</div>
				<div class="flex-item-body">
					<span class="time"><relative-time prefix="" tense="past" datetime="2025-03-01T21:34:40Z" data-tooltip-content="1 mars 2025 à 10:34 PM UTC+1" data-tooltip-interactive="true" title="" aria-label="1 mars 2025 à 10:34 PM UTC+1" aria-controls="tippy-7">2025-03-01 21:34:40 +00:00</relative-time></span>
				</div>
			</div>
		</div>
	</div>
</div>

{{if and (not .IsEmptyRepo) .LanguageStats}}
<div class="flex-item">
	<div class="flex-item-main">
		<div class="flex-item-title">
			{{ctx.Locale.Tr "repo.home.languages"}}
		</div>
		<div class="flex-item tw-flex-col stats">
			<div class="bar tw-w-full">
				{{range .LanguageStats}}
					<div class="slice tw-w-full" style="width: {{.Percentage}}%; background-color: {{.Color}}" data-tooltip-placement="top" data-tooltip-content={{.Language}} data-tooltip-follow-cursor="horizontal"></div>
				{{end}}
			</div>
			<ul class="tw-p-0 tw-m-0">
				{{range .LanguageStats}}
					<div class="item tw-flex tw-gap-1 tw-items-center">
						<i class="color-icon" style="background-color: {{.Color}}"></i>
						<span class="tw-font-semibold">
							{{if eq .Language "other"}}
								{{ctx.Locale.Tr "repo.language_other"}}
							{{else}}
								{{.Language}}
							{{end}}
						</span>
						{{.Percentage}}%
					</div>
				{{end}}
			</ul>
		</div>
	</div>
</div>
{{end}}
