{{/* Full-screen Web IDE shell: a slim bar + the vendored monaco-vscode-api workbench (public/assets/webide) in a same-origin iframe, so /_ide fetches carry the session cookie. */}}
<!DOCTYPE html>
<html lang="{{ctx.Locale.Lang}}" data-theme="{{.SignedUser.Theme}}">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{{.Title}}</title>
	<link rel="icon" href="{{AssetUrlPrefix}}/img/favicon.svg" type="image/svg+xml" />
	<style>
		html, body { margin: 0; height: 100%; background: #1e1e1e; color: #ccc;
			font-family: -apple-system, "Segoe UI", Roboto, Ubuntu, sans-serif; }
		.webide-shell { display: flex; flex-direction: column; height: 100vh; }
		.webide-bar { flex: 0 0 auto; display: flex; align-items: center; gap: .5rem;
			height: 36px; padding: 0 12px; background: #333; border-bottom: 1px solid #000; font-size: 13px; }
		.webide-bar a { color: #4daafc; text-decoration: none; }
		.webide-bar a:hover { text-decoration: underline; }
		.webide-bar .sep { color: #666; }
		.webide-frame { flex: 1 1 auto; border: 0; width: 100%; min-height: 0; }
	</style>
</head>
<body>
	<div class="webide-shell">
		<div class="webide-bar">
			<a href="{{.RepoLink}}" title="{{ctx.Locale.Tr "repo.code"}}">&larr; {{.Repository.FullName}}</a>
			<span class="sep">/</span>
			<span>{{ctx.Locale.Tr "repo.webide"}}</span>
			<span class="sep">@</span>
			<span>{{.WebIDERef}}</span>
		</div>
		<iframe class="webide-frame" title="{{ctx.Locale.Tr "repo.webide"}}"
			src="{{.RepoLink}}/_ide/app?base={{AppSubUrl}}&amp;owner={{.Repository.OwnerName}}&amp;repo={{.Repository.Name}}&amp;ref={{.WebIDERef}}&amp;commit={{.WebIDEBaseCommit}}&amp;path={{.WebIDEOpenPath}}"></iframe>
	</div>
</body>
</html>
