<span class="text"><strong>{{ctx.Locale.TrN .NumParticipants "repo.issues.num_participants_one" "repo.issues.num_participants_few" .NumParticipants}}</strong></span>
<div class="ui list tw-flex tw-flex-wrap participants">
	{{range .Participants}}
		<a class="participant" 
			{{if gt .ID 0}}href="{{.HomeLink}}"{{end}}
			data-key="{{.Name}} {{.FullName}}"
			data-value="{{.Name}}"
			data-name="{{.Name}}"
			data-fullname="{{.FullName}}"
			data-avatar="{{.AvatarLink $.Context}}"
			data-tooltip-content="{{.GetDisplayName}}">
			{{ctx.AvatarUtils.Avatar . 28 "tw-my-0.5 tw-mr-1"}}
		</a>
	{{end}}
</div>
